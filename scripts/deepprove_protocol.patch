+//! Persistent GPU prover for fresh PoML inference attempts.
+use clap::Parser;
+use tracing_subscriber::EnvFilter;
+#[derive(Parser)]
+struct Args {
+    #[arg(long)]
+    verify: Option<std::path::PathBuf>,
+    #[arg(long, requires = "verify")]
+    setup_directory: Option<std::path::PathBuf>,
+    #[arg(long, default_value = "openai-community/gpt2")]
+    model: String,
+    #[arg(long, default_value_t = 64)]
+    context: usize,
+    #[arg(long, default_value_t = 8)]
+    threads: usize,
+    #[arg(long, default_value_t = 1.0)]
+    temperature: f64,
+    #[arg(long, default_value_t = 50)]
+    top_k: usize,
+    #[arg(long, default_value_t = 0.95)]
+    top_p: f64,
+}
+fn main() -> anyhow::Result<()> {
+    tracing_subscriber::fmt()
+        .with_env_filter(EnvFilter::from_default_env())
+        .with_writer(std::io::stderr)
+        .init();
+    let args = Args::parse();
+    rayon::ThreadPoolBuilder::new()
+        .num_threads(args.threads)
+        .build_global()?;
+    if let Some(directory) = args.verify {
+        return zkml::model::poml::verify_saved(
+            args.setup_directory
+                .as_deref()
+                .ok_or_else(|| anyhow::anyhow!("--setup-directory required"))?,
+            &directory,
+        );
+    }
+    zkml::model::poml::serve(
+        &args.model,
+        args.context,
+        zkml::model::poml::Decoding {
+            temperature: args.temperature,
+            top_k: args.top_k,
+            top_p: args.top_p,
+        },
+    )
+}
