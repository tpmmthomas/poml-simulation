+//! Fresh PoML GPT-2 execution with public embedding noise and proved logits.
+//! One fixed model/setup serves requests; no inference or proof is replayed.
+use crate::{
+    Element, Shape, Tensor,
+    layers::add::Add,
+    model::{BaseRunner, HandleLifetimeRunner, Layer, Trace, llm::Driver, tensor_to_handles},
+    parser::{llm::models::gpt2::GPT2, safe::RawSafeTensors},
+    quantization::ModelMetadata,
+    verify,
+};
+use anyhow::{Context, Result, ensure};
+use ark_bn254::Bn254;
+#[cfg(not(feature = "cuda"))]
+use dp_crypto::arkyper::HyperKZG;
+#[cfg(feature = "cuda")]
+use dp_crypto::arkyper::hyperkzg_gpu::HyperKZGGpu;
+use dp_crypto::arkyper::transcript::blake3::Blake3Transcript;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    fs::{self, File},
+    io::{BufRead, Write},
+    path::Path,
+    time::Instant,
+};
+use tenstore::GenStore;
+
+type F = ark_bn254::Fr;
+#[cfg(feature = "cuda")]
+type Pcs = HyperKZGGpu<Bn254>;
+#[cfg(not(feature = "cuda"))]
+type Pcs = HyperKZG<Bn254>;
+
+#[derive(Clone, Serialize, Deserialize)]
+pub struct Request {
+    pub uniforms: Vec<u64>,
+    pub request_id: String,
+    pub prompt_tokens: Vec<usize>,
+    pub noise: Vec<Vec<f64>>,
+    pub max_output: usize,
+    pub mode: String,
+    pub output_directory: String,
+}
+
+#[derive(Serialize)]
+struct Response {
+    request_id: String,
+    output_tokens: Vec<usize>,
+    output_length: usize,
+    stop_reason: String,
+    inference_seconds: f64,
+    proof_seconds: f64,
+    verification_seconds: f64,
+    verified: bool,
+    proof_sha256: Option<String>,
+    proof_size_bytes: u64,
+    noise_scale: f32,
+    logits_scale: f32,
+    logits_shape: Vec<usize>,
+    context_length: usize,
+}
+
+fn embedding_std(driver: &Driver<f32>) -> Result<f64> {
+    let layer = driver
+        .model
+        .graph()
+        .node(driver.md.embeddings)
+        .and_then(|n| n.as_inner())
+        .context("missing embeddings")?;
+    let Layer::Embeddings(emb) = layer else {
+        anyhow::bail!("expected GPT-2 embeddings")
+    };
+    let handle = emb.mat.clone().tensor_variant()?;
+    let tensor = handle.tensor()?;
+    let count = tensor.data().len() as f64;
+    let mean = tensor.data().iter().map(|&x| x as f64).sum::<f64>() / count;
+    Ok((tensor
+        .data()
+        .iter()
+        .map(|&x| (x as f64 - mean).powi(2))
+        .sum::<f64>()
+        / count)
+        .sqrt())
+}
+
+fn install_noise(driver: &mut Driver<Element>, metadata: &ModelMetadata) -> Result<(f32, f32)> {
+    let embedding_scale = *metadata.layer_output_scaling_factor(driver.md.embeddings)[0];
+    let logits_scale = metadata.layer_input_scaling_factor(driver.md.argmax)[0].scale();
+    let graph = driver.model.graph_mut();
+    let old_edges: Vec<_> = graph
+        .outgoings(driver.md.embeddings)
+        .map(|(id, edge)| (*id, edge.clone()))
+        .collect();
+    let input = graph.add_input(1)?;
+    let add = graph.add_inner(Layer::Add(Add::same_scale(embedding_scale)))?;
+    for (id, edge) in old_edges {
+        graph.remove_edge(&id)?;
+        graph.add_edge(add, edge.target(), edge.ports().clone(), None)?;
+    }
+    graph.add_edge(driver.md.embeddings, add, (0, 0), None)?;
+    graph.add_edge(input, add, (0, 1), None)?;
+    // SECURITY: expose the constrained logits as the sole graph output.
+    // Sampling is checked by the composite verifier on this public statement.
+    let source = graph.incoming_feeds(driver.md.argmax)[0].source;
+    let outgoing: Vec<_> = graph
+        .outgoings(driver.md.argmax)
+        .map(|(id, e)| (*id, e.clone()))
+        .collect();
+    let incoming: Vec<_> = graph
+        .incomings(driver.md.argmax)
+        .map(|(id, _)| *id)
+        .collect();
+    for id in incoming {
+        graph.remove_edge(&id)?;
+    }
+    for (id, edge) in outgoing {
+        graph.remove_edge(&id)?;
+        graph.add_edge(source.node_id, edge.target(), (source.port, 0.into()), None)?;
+    }
+    graph.remove_disconnected_node(driver.md.argmax)?;
+    driver
+        .model
+        .set_input_shapes(vec![Shape::from(vec![1]), Shape::from(vec![1, 768])]);
+    Ok((embedding_scale.scale(), logits_scale))
+}
+
+fn noise_tensor(
+    noise: &[Vec<f64>],
+    start: usize,
+    rows: usize,
+    scale: f32,
+) -> Result<Tensor<Element>> {
+    let mut values = Vec::with_capacity(rows * 768);
+    for pos in start..start + rows {
+        for col in 0..768 {
+            let value = noise.get(pos).map_or(0.0, |row| row[col]);
+            ensure!(
+                value.is_finite() && value.abs() < 100.0,
+                "invalid embedding noise"
+            );
+            values.push((value / scale as f64).round_ties_even() as Element);
+        }
+    }
+    Tensor::new(Shape::from(vec![rows, 768]), values)
+}
+
+fn validate_request(req: &Request, context: usize, vocab: usize) -> Result<()> {
+    let n = req.prompt_tokens.len();
+    ensure!(
+        n >= 2 && req.max_output >= 1 && n + req.max_output <= context,
+        "invalid prompt/output lengths"
+    );
+    ensure!(
+        req.prompt_tokens.iter().all(|&t| t < vocab),
+        "invalid token"
+    );
+    ensure!(
+        req.noise.len() == n && req.noise.iter().all(|row| row.len() == 768),
+        "noise must be N by 768"
+    );
+    ensure!(
+        req.mode == "profile" || req.mode == "prove",
+        "mode must be profile or prove"
+    );
+    ensure!(
+        req.uniforms.len() == req.max_output && req.uniforms.iter().all(|&u| u < (1u64 << 53)),
+        "one 53-bit uniform per reserved decoding step required"
+    );
+    Ok(())
+}
+
+fn infer(
+    driver: &Driver<Element>,
+    req: &Request,
+    scale: f32,
+    logits_scale: f32,
+    decoding: &Decoding,
+) -> Result<(Vec<usize>, Vec<Element>, Trace<Element>)> {
+    driver.model.reset();
+    let n = req.prompt_tokens.len();
+    let mut sentence: Vec<Element> = req.prompt_tokens.iter().map(|&t| t as Element).collect();
+    let mut decoded = Vec::new();
+    let mut cached_logits = Vec::new();
+    let mut store = GenStore::default();
+    let mut runner =
+        HandleLifetimeRunner::new(BaseRunner::from(store.clone()), driver.model.graph());
+    let vocab = driver.md.vocab_size();
+    // The extra final cached row matches the appendix reference driver's
+    // trace-reconstruction schedule. It does not add a delivered token.
+    for step in 0..=req.max_output {
+        let tokens = if step == 0 {
+            sentence.clone()
+        } else {
+            vec![*sentence.last().unwrap()]
+        };
+        let start = if step == 0 { 0 } else { n + step - 1 };
+        let rows = tokens.len();
+        let inputs = vec![
+            Tensor::new(Shape::from(vec![rows]), tokens)?,
+            noise_tensor(&req.noise, start, rows, scale)?,
+        ];
+        let handles = tensor_to_handles(&inputs, driver.model.graph(), &mut store)?;
+        driver.model.run_with_runner(&mut runner, handles)?;
+        let outputs = runner.model_outputs(driver.model.graph())?;
+        ensure!(outputs.len() == 1, "expected proved logits");
+        let logits_handle = outputs[0].clone().tensor_variant()?;
+        let logits = logits_handle.tensor()?;
+        let width = logits.shape().dim(-1);
+        let row = (logits.shape().dim(0) - 1) * width;
+        // Complete the final cached row even after EOS, so the final full
+        // trace reuses the same attention-softmax shifts for every position.
+        if step == req.max_output
+            || decoded.last() == Some(&usize::from(driver.md.config.eos_token))
+        {
+            break;
+        }
+        let next = sample(
+            &logits.data()[row..row + vocab],
+            logits_scale,
+            req.uniforms[step],
+            decoding,
+        )?;
+        cached_logits.extend_from_slice(&logits.data()[row..row + vocab]);
+        decoded.push(next);
+        sentence.push(next as Element);
+    }
+    drop(runner);
+    driver
+        .model
+        .reset_selective(&[crate::layers::transformer::softmax::SOFTMAX_LAYER]);
+    let s = sentence.len();
+    let trace = driver.model.run(
+        vec![
+            Tensor::new(Shape::from(vec![s]), sentence.clone())?,
+            noise_tensor(&req.noise, 0, s, scale)?,
+        ],
+        &mut GenStore::default(),
+    )?;
+    let outputs = trace.outputs();
+    let logits_handle = outputs[0].clone().tensor_variant()?;
+    let logits = logits_handle.tensor()?;
+    let width = logits.shape().dim(-1);
+    for (step, &token) in decoded.iter().enumerate() {
+        let row = n - 1 + step;
+        ensure!(
+            sample(
+                &logits.data()[row * width..row * width + vocab],
+                logits_scale,
+                req.uniforms[step],
+                decoding
+            )? == token,
+            "cached/final decoding mismatch at {step}"
+        );
+        ensure!(
+            logits.data()[row * width..row * width + vocab]
+                == cached_logits[step * vocab..(step + 1) * vocab],
+            "cached/final logits mismatch at {step}"
+        );
+    }
+    drop(logits);
+    Ok((decoded, cached_logits, trace))
+}
+
+fn write_i64(path: &Path, values: &[Element]) -> Result<()> {
+    let mut file = std::io::BufWriter::new(File::create(path)?);
+    for &value in values {
+        file.write_all(&value.to_le_bytes())?;
+    }
+    file.flush()?;
+    Ok(())
+}
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+/// Serve requests using a fixed quantized graph and setup over newline JSON.
+pub fn serve(model: &str, max_context: usize, decoding: Decoding) -> Result<()> {
+    decoding.validate()?;
+    let raw = RawSafeTensors::from_hugging_face_cached(model)?;
+    let model_files = serde_json::json!({
+        "weights_sha256":digest(&fs::read(raw.model_path())?),
+        "config_sha256":digest(&fs::read(raw.config_path())?),
+        "tokenizer_sha256":digest(&fs::read(raw.tokenizer_path())?)});
+    let floating = Driver::load_from_model(GPT2::new(), &raw, Some(max_context))?;
+    let std = embedding_std(&floating)?;
+    let (mut driver, metadata) = floating.into_provable_llm(None)?;
+    let (noise_scale, logits_scale) = install_noise(&mut driver, &metadata)?;
+    drop(metadata);
+    let started = Instant::now();
+    let setup_directory =
+        std::env::var("POML_SETUP_DIRECTORY").context("setup directory required")?;
+    let setup_path = Path::new(&setup_directory);
+    fs::create_dir_all(setup_path)?;
+    let contract = Contract {
+        context: max_context,
+        noise_scale,
+        logits_scale,
+        decoding: decoding.clone(),
+        eos: usize::from(driver.md.config.eos_token),
+    };
+    let (prover, verifier) = if setup_path.join("prover.bin.zst").exists() {
+        let old: Contract = serde_json::from_slice(&fs::read(setup_path.join("contract.json"))?)?;
+        ensure!(
+            serde_json::to_vec(&old)? == serde_json::to_vec(&contract)?,
+            "registered model/decoder contract changed"
+        );
+        let bytes =
+            zstd::stream::decode_all(fs::read(setup_path.join("prover.bin.zst"))?.as_slice())?;
+        let (prover, _): (crate::ProverContext<'static, F, Pcs>, usize) =
+            bincode::serde::decode_from_slice(&bytes, bincode::config::standard())?;
+        let (verifier, _): (crate::iop::context::VerifierContext<F, Pcs>, usize) =
+            bincode::serde::decode_from_slice(
+                &fs::read(setup_path.join("verifier.bin"))?,
+                bincode::config::standard(),
+            )?;
+        (prover, verifier)
+    } else {
+        let (prover, verifier) =
+            driver
+                .model
+                .generate_contexts_for_input_shapes::<F, Pcs>(vec![
+                    Shape::from(vec![max_context]),
+                    Shape::from(vec![max_context, 768]),
+                ])?;
+        // Persist the actual CRS/model commitments. Regenerating setup on restart
+        // is not a replacement for keeping one registered setup for the chain.
+        let bytes = bincode::serde::encode_to_vec(&prover, bincode::config::standard())?;
+        fs::write(
+            setup_path.join("prover.bin.zst.partial"),
+            zstd::stream::encode_all(bytes.as_slice(), 3)?,
+        )?;
+        fs::write(
+            setup_path.join("verifier.bin"),
+            bincode::serde::encode_to_vec(&verifier, bincode::config::standard())?,
+        )?;
+        fs::write(
+            setup_path.join("contract.json"),
+            serde_json::to_vec_pretty(&contract)?,
+        )?;
+        fs::rename(
+            setup_path.join("prover.bin.zst.partial"),
+            setup_path.join("prover.bin.zst"),
+        )?;
+        (prover, verifier)
+    };
+    let setup_bytes = bincode::serde::encode_to_vec(&verifier, bincode::config::standard())?;
+    let ready = serde_json::json!({"event":"ready","backend":if cfg!(feature="cuda"){"cuda"}else{"cpu"},
+        "embedding_std":std,"noise_scale":noise_scale,"logits_scale":logits_scale,
+        "setup_sha256":digest(&setup_bytes),"setup_seconds":started.elapsed().as_secs_f64(),
+        "context_limit":max_context,"model_files":model_files,"decoding":decoding,"selection_proof":"composite verifier over public logits","schema":"poml-live-proof-1"});
+    println!("{}", ready);
+    std::io::stdout().flush()?;
+    for line in std::io::stdin().lock().lines() {
+        let req: Request = serde_json::from_str(&line?)?;
+        validate_request(&req, max_context, driver.md.vocab_size())?;
+        let output = Path::new(&req.output_directory);
+        fs::create_dir_all(output)?;
+        eprintln!("POML_EVENT request={} stage=inference", req.request_id);
+        let start = Instant::now();
+        let (decoded, logits, trace) = infer(&driver, &req, noise_scale, logits_scale, &decoding)?;
+        let inference_seconds = start.elapsed().as_secs_f64();
+        let mut response = Response {
+            request_id: req.request_id.clone(),
+            output_length: decoded.len(),
+            stop_reason: if decoded.last() == Some(&usize::from(driver.md.config.eos_token)) {
+                "eos"
+            } else {
+                "length_cap"
+            }
+            .into(),
+            output_tokens: decoded,
+            inference_seconds,
+            proof_seconds: 0.0,
+            verification_seconds: 0.0,
+            verified: false,
+            proof_sha256: None,
+            proof_size_bytes: 0,
+            noise_scale,
+            logits_scale,
+            logits_shape: vec![
+                logits.len() / driver.md.vocab_size(),
+                driver.md.vocab_size(),
+            ],
+            context_length: req.prompt_tokens.len() + logits.len() / driver.md.vocab_size(),
+        };
+        if req.mode == "prove" {
+            write_i64(&output.join("logits.i64"), &logits)?;
+            let noise = noise_tensor(&req.noise, 0, req.prompt_tokens.len(), noise_scale)?;
+            write_i64(&output.join("noise.i64"), noise.data())?;
+            eprintln!("POML_EVENT request={} stage=prove", req.request_id);
+            let start = Instant::now();
+            let (proof, io) = driver.prove(&prover, trace)?;
+            response.proof_seconds = start.elapsed().as_secs_f64();
+            let bytes = bincode::serde::encode_to_vec(&proof, bincode::config::standard())?;
+            response.proof_sha256 = Some(digest(&bytes));
+            response.proof_size_bytes = bytes.len() as u64;
+            fs::write(output.join("proof.bin"), &bytes)?;
+            let statement = bincode::serde::encode_to_vec(&io, bincode::config::standard())?;
+            fs::write(
+                output.join("statement.bin.zst"),
+                zstd::stream::encode_all(statement.as_slice(), 3)?,
+            )?;
+            let start = Instant::now();
+            // The public statement is checked before accepting the NN proof.
+            verify_selection(
+                &io,
+                &req,
+                noise_scale,
+                logits_scale,
+                &decoding,
+                usize::from(driver.md.config.eos_token),
+            )?;
+            verify::<F, Blake3Transcript, Pcs>(&verifier, proof, io)?;
+            response.verification_seconds = start.elapsed().as_secs_f64();
+            response.verified = true;
+        }
+        let json = serde_json::to_string(&response)?;
+        fs::write(output.join("result.json"), &json)?;
+        println!("{}", json);
+        std::io::stdout().flush()?;
+    }
+    Ok(())
+}
