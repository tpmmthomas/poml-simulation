+#[derive(Serialize, Deserialize)]
+struct Contract {
+    context: usize,
+    noise_scale: f32,
+    logits_scale: f32,
+    decoding: Decoding,
+    eos: usize,
+}
+
+/// Verify an archived composite proof against the trusted registered setup.
+pub fn verify_saved(setup: &Path, directory: &Path) -> Result<()> {
+    let contract: Contract = serde_json::from_slice(&fs::read(setup.join("contract.json"))?)?;
+    let req: Request = serde_json::from_slice(&fs::read(directory.join("request.json"))?)?;
+    validate_request(&req, contract.context, 50257)?;
+    let (verifier, _): (crate::iop::context::VerifierContext<F, Pcs>, usize) =
+        bincode::serde::decode_from_slice(
+            &fs::read(setup.join("verifier.bin"))?,
+            bincode::config::standard(),
+        )?;
+    let (proof, _): (crate::Proof<F, Pcs>, usize) = bincode::serde::decode_from_slice(
+        &fs::read(directory.join("proof.bin"))?,
+        bincode::config::standard(),
+    )?;
+    let (io, _): (crate::IO<F>, usize) = bincode::serde::decode_from_slice(
+        &zstd::stream::decode_all(fs::read(directory.join("statement.bin.zst"))?.as_slice())?,
+        bincode::config::standard(),
+    )?;
+    verify_selection(
+        &io,
+        &req,
+        contract.noise_scale,
+        contract.logits_scale,
+        &contract.decoding,
+        contract.eos,
+    )?;
+    verify::<F, Blake3Transcript, Pcs>(&verifier, proof, io)?;
+    println!(
+        "{}",
+        serde_json::json!({"verified":true,"selection":"inverse-CDF over proved public logits"})
+    );
+    Ok(())
+}
