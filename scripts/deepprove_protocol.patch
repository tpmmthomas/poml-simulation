+/// Registered finite-precision inverse-CDF decoder over public integer logits.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Decoding {
+    pub temperature: f64,
+    pub top_k: usize,
+    pub top_p: f64,
+}
+impl Decoding {
+    fn validate(&self) -> Result<()> {
+        ensure!(
+            self.temperature.is_finite() && self.temperature > 0.0,
+            "invalid temperature"
+        );
+        ensure!(
+            self.top_p.is_finite() && self.top_p > 0.0 && self.top_p <= 1.0,
+            "invalid top_p"
+        );
+        Ok(())
+    }
+}
+
+fn sample(logits: &[Element], scale: f32, u: u64, decoding: &Decoding) -> Result<usize> {
+    decoding.validate()?;
+    ensure!(
+        !logits.is_empty() && u < (1u64 << 53),
+        "invalid logits or uniform"
+    );
+    let mut order: Vec<usize> = (0..logits.len()).collect();
+    // Token-id tie breaking and integer CDF intervals make selection unique.
+    order.sort_unstable_by(|&a, &b| logits[b].cmp(&logits[a]).then(a.cmp(&b)));
+    if decoding.top_k > 0 {
+        order.truncate(decoding.top_k.min(order.len()));
+    }
+    let maximum = logits[order[0]];
+    let mut weights: Vec<(usize, u64)> = order
+        .iter()
+        .map(|&i| {
+            let exponent = (logits[i] - maximum) as f64 * scale as f64 / decoding.temperature;
+            (
+                i,
+                (exponent.exp() * (1u64 << 48) as f64).round_ties_even() as u64,
+            )
+        })
+        .collect();
+    let total: u64 = weights.iter().map(|(_, w)| *w).sum();
+    let mut cumulative = 0u64;
+    let mut retained = weights.len();
+    for (i, (_, weight)) in weights.iter().enumerate() {
+        cumulative += weight;
+        if cumulative as f64 >= decoding.top_p * total as f64 {
+            retained = i + 1;
+            break;
+        }
+    }
+    weights.truncate(retained);
+    let total: u64 = weights.iter().map(|(_, w)| *w).sum();
+    let target = ((u as u128 * total as u128) >> 53) as u64;
+    let mut cumulative = 0;
+    for (token, weight) in weights {
+        cumulative += weight;
+        if target < cumulative {
+            return Ok(token);
+        }
+    }
+    anyhow::bail!("inverse CDF did not select a token")
+}
+
+// SECURITY: This is part of the composite proof verifier. It checks the actual
+// proof IO, not a separately generated text file or an unbound sampled output.
+fn verify_selection(
+    io: &crate::IO<F>,
+    req: &Request,
+    noise_scale: f32,
+    logits_scale: f32,
+    decoding: &Decoding,
+    eos: usize,
+) -> Result<()> {
+    ensure!(
+        io.input.len() == 2 && io.output.len() == 1,
+        "invalid composite IO arity"
+    );
+    let input = io.input[0].to_element();
+    let noise = io.input[1].to_element();
+    let logits = io.output[0].to_element();
+    let n = req.prompt_tokens.len();
+    let s = input.unpadded_shape().product();
+    let k = s.checked_sub(n).context("sequence shorter than prompt")?;
+    ensure!(k >= 1 && k <= req.max_output, "invalid realised K");
+    ensure!(
+        input.data()[..n]
+            .iter()
+            .map(|&x| x as usize)
+            .eq(req.prompt_tokens.iter().copied()),
+        "prompt mismatch"
+    );
+    let expected = noise_tensor(&req.noise, 0, s, noise_scale)?;
+    ensure!(
+        noise.unpadded_shape().as_ref() == expected.unpadded_shape().as_ref(),
+        "noise shape mismatch"
+    );
+    for row in 0..noise.shape().dim(0) {
+        for col in 0..noise.shape().dim(1) {
+            let value = if row < s && col < 768 {
+                expected.data()[row * 768 + col]
+            } else {
+                0
+            };
+            ensure!(
+                noise.data()[row * noise.shape().dim(1) + col] == value,
+                "noise binding/padding mismatch"
+            );
+        }
+    }
+    let vocab = logits.unpadded_shape().dim(-1);
+    let width = logits.shape().dim(-1);
+    for t in 0..k {
+        let selected = sample(
+            &logits.data()[(n - 1 + t) * width..(n - 1 + t) * width + vocab],
+            logits_scale,
+            req.uniforms[t],
+            decoding,
+        )?;
+        ensure!(
+            input.data()[n + t] as usize == selected,
+            "sampled token mismatch at {t}"
+        );
+        ensure!(t + 1 == k || selected != eos, "tokens after EOS");
+    }
+    ensure!(
+        k == req.max_output || input.data()[n + k - 1] as usize == eos,
+        "early termination without EOS"
+    );
+    Ok(())
+}
