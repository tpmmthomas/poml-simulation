+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn inverse_cdf_uses_randomness_and_deterministic_ties() {
+        let d = Decoding {
+            temperature: 1.0,
+            top_k: 0,
+            top_p: 1.0,
+        };
+        assert_eq!(sample(&[0, 0], 1.0, 0, &d).unwrap(), 0);
+        assert_eq!(sample(&[0, 0], 1.0, 1u64 << 52, &d).unwrap(), 1);
+        assert_eq!(sample(&[0, 0], 1.0, (1u64 << 53) - 1, &d).unwrap(), 1);
+        assert!(sample(&[0, 0], 1.0, 1u64 << 53, &d).is_err());
+    }
+    #[test]
+    fn top_k_and_top_p_filter_before_sampling() {
+        let d = Decoding {
+            temperature: 1.0,
+            top_k: 1,
+            top_p: 1.0,
+        };
+        assert_eq!(sample(&[0, 1], 1.0, 0, &d).unwrap(), 1);
+        let d = Decoding {
+            temperature: 1.0,
+            top_k: 0,
+            top_p: 0.4,
+        };
+        assert_eq!(sample(&[0, 0], 1.0, (1u64 << 53) - 1, &d).unwrap(), 0);
+    }
+    #[test]
+    fn composite_verifier_rejects_wrong_token_uniform_noise_and_early_stop() {
+        use crate::quantization::ToField;
+        let d = Decoding {
+            temperature: 1.0,
+            top_k: 0,
+            top_p: 1.0,
+        };
+        let mut req = Request {
+            request_id: "test".into(),
+            prompt_tokens: vec![0, 0],
+            noise: vec![vec![0.0; 768]; 2],
+            max_output: 1,
+            uniforms: vec![0],
+            mode: "prove".into(),
+            output_directory: "unused".into(),
+        };
+        let tensor = |shape: Vec<usize>, values: Vec<Element>| {
+            Tensor::new(
+                Shape::from(shape),
+                values.iter().map(|&x| x.to_field()).collect(),
+            )
+            .unwrap()
+        };
+        let io = crate::IO::<F>::new(
+            vec![
+                tensor(vec![3], vec![0, 0, 0]),
+                tensor(vec![3, 768], vec![0; 3 * 768]),
+            ],
+            vec![tensor(vec![3, 2], vec![0; 6])],
+        );
+        assert!(verify_selection(&io, &req, 1.0, 1.0, &d, 1).is_ok());
+        req.uniforms[0] = 1u64 << 52;
+        assert!(verify_selection(&io, &req, 1.0, 1.0, &d, 1).is_err());
+        req.uniforms[0] = 0;
+        req.noise[0][0] = 1.0;
+        assert!(verify_selection(&io, &req, 1.0, 1.0, &d, 1).is_err());
+        req.noise[0][0] = 0.0;
+        req.max_output = 2;
+        req.uniforms.push(0);
+        assert!(verify_selection(&io, &req, 1.0, 1.0, &d, 1).is_err());
+        req.max_output = 1;
+        req.uniforms.pop();
+        let wrong = crate::IO::<F>::new(
+            vec![
+                tensor(vec![3], vec![0, 0, 1]),
+                tensor(vec![3, 768], vec![0; 3 * 768]),
+            ],
+            vec![tensor(vec![3, 2], vec![0; 6])],
+        );
+        assert!(verify_selection(&wrong, &req, 1.0, 1.0, &d, 1).is_err());
+    }
+}
