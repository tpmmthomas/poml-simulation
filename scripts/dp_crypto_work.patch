+++ b/dp-crypto/src/work.rs
@@ -0,0 +1,81 @@
+//! Optional shape-only operation ledger. Never records witness values or timing.
+use serde_json::{json, Value};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Mutex,
+};
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static EVENTS: Mutex<Vec<Value>> = Mutex::new(Vec::new());
+static PHASE: Mutex<&'static str> = Mutex::new("excluded");
+
+/// Return whether an online trial is currently being recorded.
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// Start one online trial; setup and verification must be outside this scope.
+pub fn begin() {
+    EVENTS.lock().unwrap().clear();
+    *PHASE.lock().unwrap() = "inference";
+    ENABLED.store(true, Ordering::Relaxed);
+}
+
+/// Label subsequent events after the preceding phase has finished.
+pub fn phase(name: &'static str) {
+    *PHASE.lock().unwrap() = name;
+}
+
+/// Append a structural event only while a trial is being metered.
+pub fn record(mut event: Value) {
+    if !enabled() {
+        return;
+    }
+    event["phase"] = json!(*PHASE.lock().unwrap());
+    EVENTS.lock().unwrap().push(event);
+}
+
+/// Disable recording before verification and return this trial's events.
+pub fn finish() -> Vec<Value> {
+    ENABLED.store(false, Ordering::Relaxed);
+    std::mem::take(&mut *EVENTS.lock().unwrap())
+}
+
+/// Fingerprint the serialized setup used by one metering run.
+pub fn digest(bytes: &[u8]) -> String {
+    blake3::hash(bytes).to_hex().to_string()
+}
+
+/// Recover a power-of-two stored prefix before zero-padded worker splitting.
+/// Empty suffix workers contain a one-element zero placeholder; those entries
+/// are representation overhead and must not inflate the reference domain.
+pub(crate) fn prefix_len(chunk_size: usize, lengths: &[usize]) -> usize {
+    assert!(chunk_size > 1 && chunk_size.is_power_of_two() && !lengths.is_empty());
+    let full = lengths.iter().take_while(|&&n| n == chunk_size).count();
+    let result = if full == 0 {
+        lengths[0]
+    } else {
+        full * chunk_size
+    };
+    assert!(result.is_power_of_two());
+    result
+}
