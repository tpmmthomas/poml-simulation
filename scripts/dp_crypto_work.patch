+#[cfg(test)]
+mod tests {
+    #[test]
+    fn recovers_stored_prefix_independent_of_worker_count() {
+        for logical_bits in 1..=20 {
+            for stored_bits in 0..=logical_bits {
+                for worker_bits in 0..logical_bits.min(4) {
+                    let chunk = 1 << (logical_bits - worker_bits);
+                    let stored = 1usize << stored_bits;
+                    let parts: Vec<_> = (0..1 << worker_bits)
+                        .map(|i| stored.saturating_sub(i * chunk).min(chunk).max(1))
+                        .collect();
+                    assert_eq!(super::prefix_len(chunk, &parts), stored);
+                }
+            }
+        }
+    }
+}
