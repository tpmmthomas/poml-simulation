+/// Validate exact token replays before quantization/setup or online execution.
+fn explicit_workloads(
+    prompts: Vec<Vec<usize>>,
+    sequence: &[(usize, usize)],
+    vocab_size: usize,
+) -> anyhow::Result<Vec<(Vec<Token>, usize)>> {
+    ensure!(prompts.len() == sequence.len(), "Need one prompt per pair");
+    prompts
+        .into_iter()
+        .zip(sequence)
+        .map(|(tokens, &(n, total))| {
+            ensure!(tokens.len() == n, "Prompt token count must equal N");
+            ensure!(
+                tokens.iter().all(|&t| t < vocab_size),
+                "Prompt token outside vocabulary"
+            );
+            Ok((tokens.into_iter().map(Token::from).collect(), total))
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn accepts_exact_token_replay() {
+        let workloads = explicit_workloads(vec![vec![1, 2]], &[(2, 5)], 3).unwrap();
+        assert_eq!(workloads[0].0.len(), 2);
+        assert_eq!(workloads[0].1, 5);
+        assert_eq!(workloads[0].0[0].as_tensor_type_param::<i64>(), 1);
+    }
+
+    #[test]
+    fn rejects_malformed_token_replays() {
+        assert!(explicit_workloads(vec![], &[(2, 5)], 3).is_err());
+        assert!(explicit_workloads(vec![vec![1]], &[(2, 5)], 3).is_err());
+        assert!(explicit_workloads(vec![vec![1, 3]], &[(2, 5)], 3).is_err());
+    }
+
+    #[test]
+    fn ledger_requires_fixed_length_and_rejects_distributed() {
+        let base = [
+            "bench-llm",
+            "--model",
+            "gpt2",
+            "--hf",
+            "openai-community/gpt2",
+            "--pairs",
+            "2:2",
+            "--work-ledger",
+            "ledger.jsonl",
+        ];
+        assert!(LLMArgs::try_parse_from(base).is_err());
+        let fixed = base.into_iter().chain(["--fixed-length"]);
+        assert!(LLMArgs::try_parse_from(fixed.clone()).is_ok());
+        assert!(LLMArgs::try_parse_from(fixed.chain(["--distributed"])).is_err());
+    }
+
+    #[test]
+    fn accepts_repeated_prompts_with_max_context() {
+        let args = LLMArgs::try_parse_from([
+            "bench-llm",
+            "--model",
+            "gpt2",
+            "--hf",
+            "openai-community/gpt2",
+            "--max-context",
+            "8",
+            "--prompt",
+            "Proofs bind computation",
+            "--prompt",
+            "Verification checks claims",
+        ])
+        .unwrap();
+
+        assert_eq!(
+            args.prompt,
+            ["Proofs bind computation", "Verification checks claims"]
+        );
+    }
+
+    #[test]
+    fn rejects_prompt_without_max_context() {
+        let result = LLMArgs::try_parse_from([
+            "bench-llm",
+            "--model",
+            "gpt2",
+            "--hf",
+            "openai-community/gpt2",
+            "--prompt",
+            "Proofs bind computation",
